PORT=4000
# Optional: enable PostgreSQL persistence in production
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# Optional: JSON array file for profiles (default: <backend cwd>/data/profiles.json)
# PROFILE_DB_PATH=data/profiles.json
# Optional: memory | json | postgres (default: json)
# PROFILE_DB_MODE=memory
# Comma-separated list supported (first origin is used for redirects)
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_SUCCESS_URL=http://localhost:5173/#/members
SESSION_SECRET=replace_with_long_random_secret
SESSION_TTL_MS=86400000
DISCORD_CLIENT_ID=your_client_id
DISCORD_CLIENT_SECRET=your_client_secret
DISCORD_REDIRECT_URI=http://localhost:4000/auth/discord/callback
# Optional: set false for lightweight local development
DISCORD_BOT_ENABLED=true
DISCORD_BOT_TOKEN=your_bot_token
# Guild membership is required for login approval.
# Defaults to WESTSIDE guild if omitted, but set this explicitly for your server.
DISCORD_GUILD_ID=1316272904639479891
APPROVAL_ADMIN_DISCORD_ID=1295395830865461260
APPROVAL_REQUEST_TIMEOUT_MS=300000
APPROVAL_ALLOW_ON_UNAVAILABLE=false
