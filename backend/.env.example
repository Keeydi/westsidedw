# Server
PORT=4000
NODE_ENV=production

# Persistence mode: memory | json | postgres
PROFILE_DB_MODE=postgres
# PROFILE_DB_PATH=./data/profiles.json
DATABASE_URL=postgresql://user:password@host:5432/database

# Frontend integration (comma-separated list supported for FRONTEND_ORIGIN)
FRONTEND_ORIGIN=https://your-site.netlify.app
FRONTEND_SUCCESS_URL=https://your-site.netlify.app/#/members

# Session
SESSION_SECRET=replace_with_long_random_secret
SESSION_TTL_MS=86400000

# Discord OAuth + bot
DISCORD_CLIENT_ID=replace_me
DISCORD_CLIENT_SECRET=replace_me
DISCORD_REDIRECT_URI=https://your-backend.onrender.com/auth/discord/callback
DISCORD_BOT_ENABLED=true
DISCORD_BOT_TOKEN=replace_me
DISCORD_GUILD_ID=replace_me

# Approval flow
APPROVAL_ADMIN_DISCORD_ID=replace_me
APPROVAL_REQUEST_TIMEOUT_MS=300000
APPROVAL_ALLOW_ON_UNAVAILABLE=false
